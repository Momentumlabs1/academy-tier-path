# --- Vinted ---
VINTED_DOMAIN=vinted.at

# Am stabilsten: kompletter Cookie-Header aus dem EINGELOGGTEN Browser.
# So holst du ihn: vinted.at eingeloggt oeffnen -> DevTools (F12) -> Tab
# "Network" -> irgendeinen /api/v2/... Request anklicken -> Request Headers ->
# Zeile "cookie:" kopieren und hier komplett einfuegen (in Anfuehrungszeichen).
# Ohne Cookie versucht das Script eine anonyme Session (kann geblockt werden).
VINTED_COOKIE=""

# Optional: eigener User-Agent (moeglichst der deines echten Browsers)
# VINTED_USER_AGENT=""

# --- Polling ---
POLL_INTERVAL_MS=30000     # Pause zwischen kompletten Zyklen
POLL_JITTER_MS=2000        # zufaellige Verzoegerung zwischen Requests (Anti-Block)
VINTED_PER_PAGE=20

# --- Telegram-Push (optional; leer lassen = nur Konsole) ---
# Bot-Token vom @BotFather; Chat-ID z.B. via @userinfobot herausfinden.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
